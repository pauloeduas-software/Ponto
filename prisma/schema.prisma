generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String        @id @db.VarChar(255)
  username     String        @unique @db.VarChar(255)
  password     String        @db.VarChar(255)
  name         String        @db.VarChar(255)
  role         String        @db.VarChar(50)
  goal         String?       @db.VarChar(50)
  avatarUrl    String?       @map("avatarurl")
  teamId       String?       @map("teamid") @db.VarChar(255)
  team         Team?         @relation(fields: [teamId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  punchRecords PunchRecord[]
  shifts       Shift[]
  userTeams    UserTeam[]

  @@map("User")
}

model PunchRecord {
  id          String  @id @db.VarChar(255)
  userId      String? @map("userid") @db.VarChar(255)
  date        String  @db.VarChar(50)
  punches     String
  workMins    Int     @map("workmins")
  diffMins    Int     @map("diffmins")
  isOvertime  Boolean @map("isovertime")
  goalMins    Int     @map("goalmins")
  observation String?
  user        User?   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("punchrecord")
}

model Shift {
  id        String  @id @db.VarChar(255)
  userId    String? @map("userid") @db.VarChar(255)
  date      String  @db.VarChar(50)
  startTime String? @map("starttime") @db.VarChar(50)
  endTime   String? @map("endtime") @db.VarChar(50)
  type      String  @db.VarChar(50)
  user      User?   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("shift")
}

model Team {
  id        String     @id @db.VarChar(255)
  name      String     @db.VarChar(255)
  createdAt DateTime?  @default(now()) @map("createdat") @db.Timestamp(6)
  users     User[]
  userTeams UserTeam[]

  @@map("team")
}

model UserTeam {
  userId String @map("userid") @db.VarChar(255)
  teamId String @map("teamid") @db.VarChar(255)
  role   String @db.VarChar(50)
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([userId, teamId])
  @@map("userteam")
}
