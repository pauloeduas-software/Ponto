# Chave secreta para as sessões (use uma frase longa e aleatória)
SESSION_SECRET="coloque_uma_chave_secreta_aqui"

# ── Padrão de portas ──────────────────────────────
# Front (app React Router — front e back no mesmo servidor)
FRONT_PORT=3000
# Postgres (porta exposta no host)
POSTGRES_PORT=3002

# Senha do Postgres (gere com: openssl rand -hex 32 — use só letras/números, vai dentro da URL)
POSTGRES_PASSWORD="troque_por_uma_senha_forte"

# URL do Banco de Dados PostgreSQL (usa a POSTGRES_PORT e a senha acima)
DATABASE_URL="postgresql://postgres:troque_por_uma_senha_forte@localhost:3002/ponto_db"
